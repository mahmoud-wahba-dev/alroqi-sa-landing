# SMTP credentials for the inquiry API. Keep this file private and never prefix
# these values with VITE_; the browser must not receive SMTP credentials.
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-mailbox@example.com
SMTP_PASS=your-provider-app-password
SMTP_FROM_NAME=Al-Ruqi Projects
